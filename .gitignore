# Presentations are not tracked.
*.ppt
*.pptx
*.pptm
*.pps
*.ppsx

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Temporary files
tmpdocs/
.numba_cache/*
cluster-packages/
benchmark-results
benchmarks/mgdrive1/cluster/
tests/test_northstar_cluster_orchestration.py
TODO.legacy.md

.DS_Store

site/*
.github/*
!.github/instructions/
!.github/instructions/**
!.github/workflows/
!.github/workflows/**

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.trae/*
.claude/*
.omo/*
.opencode/*
.codex/*
.reasonix/*
.agents/*
.zcode/*

*beamer*

*.csv
csv*

debug*
diagnose*

demos/test*

*.png
*.html
.coverage

# Frontend source files that the broad *.html / debug* rules above would swallow.
!ui/index.html
!ui/src/stores/debug.ts
!ui/src/components/panels/DebugPanel.vue

# Markdown allowlist. Keep this after other file rules so only these Markdown
# files are eligible for tracking. Excluded directories remain excluded.
*.md
!/AGENTS.en.md
!/AGENTS.md
!/CHANGELOG.md
!/CONTEXT.md
!/TODO.md
!/docstring_spec.md
!/docstring_spec_cn.md
!/quality_checks_spec.md
!/quality_checks_spec_cn.md
!README.md
!/docs/**/*.md
