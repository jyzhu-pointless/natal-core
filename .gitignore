# Markdown: keep documentation tracked — repo-root *.md, *.md under docs/, and
# README*.md anywhere (any name flavor). Every other *.md is a scratch note and
# stays out of git. GitHub Copilot instruction files keep their own exceptions in
# the .github section below. Rules further down win (gitignore is last-match-wins),
# so the junk exclusions below (TODO.legacy.md, *beamer*, csv*, debug*, diagnose*)
# still apply on top of this policy.
*.md
!/*.md
!/docs/**/*.md
!README*.md
!readme*.md

# Presentations are not tracked.
*.ppt
*.pptx
*.pptm
*.pps
*.ppsx

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Temporary files
tmpdocs/
.numba_cache/*
cluster-packages/
benchmark-results
benchmarks/mgdrive1/cluster/
tests/test_northstar_cluster_orchestration.py
TODO.legacy.md

.DS_Store

site/*
.github/*
!.github/copilot-instructions.md
!.github/instructions/
!.github/instructions/**
!.github/workflows/
!.github/workflows/**

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.trae/*
.claude/*
.omo/*
.opencode/*
.codex/*
.reasonix/*
.agents/*
.zcode/*

*beamer*

*.csv
csv*

debug*
diagnose*

demos/test*

*.png
*.html
.coverage

# Frontend source files that the broad *.html / debug* rules above would swallow.
!ui/index.html
!ui/src/stores/debug.ts
!ui/src/components/panels/DebugPanel.vue
