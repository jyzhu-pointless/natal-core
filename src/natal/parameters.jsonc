[
  // Route table: every column is data — adding a parameter is adding
  // a row; a new parameter *shape* means touching _routes.py.
  // Columns:
  //   method    — Configurator method that exposes the parameter
  //   kind      — one of the seven shapes: scalar | mode_enum | age_vec |
  //               sex_row | slot | bool | geno_tensor
  //   section   — "ecology" (genotype-free) or "genetics" (genotype-indexed)
  //   sensitive — when true, writing the parameter recomputes the
  //               equilibrium metrics (expected_competition_strength /
  //               expected_survival_rate)
  // SETUP
  {"domain": "setup", "method": "setup", "kind": "bool", "section": "ecology", "name": "stochastic", "config_field": "stochastic", "config_path": [], "dtype": "bool", "bounds": [0, 1], "sensitive": false},
  {"domain": "setup", "method": "setup", "kind": "bool", "section": "ecology", "name": "continuous_sampling", "config_field": "continuous_sampling", "config_path": [], "dtype": "bool", "bounds": [0, 1], "sensitive": false},
