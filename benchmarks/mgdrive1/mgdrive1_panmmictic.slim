// Individual-based panmictic implementation of the MGDrivE1-compatible
// stochastic lifecycle used by the NATAL benchmark.
//
// The neutral genetic architecture is selected with the CUBE constant and
// mirrors the inheritance cubes exported from MGDrivE1:
//   mendelian3    G=3   one bi-allelic locus          AA, Aa, aa
//   multiallele6  G=6   one tri-allelic locus         WW, WA, WB, AA, AB, BB
//   twolocus9     G=9   two unlinked bi-allelic loci  (A/a) x (B/b)
//   twolocus18    G=18  tri-allelic (T/K/R) x bi-allelic (W/A)
//
// Loci are unlinked for the two-locus cubes: every offspring samples each
// locus independently from each parent, matching the free-recombination
// inheritance tensors in MGDrivE1's cubeTwoLocusTA and cubeKillerRescue.

initialize() {
    if (!exists("N_DAYS"))
        defineConstant("N_DAYS", 30);
    if (!exists("TRACE"))
        defineConstant("TRACE", F);
    if (!exists("POP_SCALE"))
        defineConstant("POP_SCALE", 1);
    if (!exists("CUBE"))
        defineConstant("CUBE", "mendelian3");
    defineConstant("TIME_EGG", 5);
    defineConstant("TIME_LARVA", 6);
    defineConstant("TIME_PUPA", 4);
    defineConstant("BETA", 20.0);
    defineConstant("ADULT_SURVIVAL", 0.91);
    defineConstant("AQUATIC_SURVIVAL", 0.9733398601528126);
    defineConstant("ALPHA", 125.47808499344363 * POP_SCALE);
    // The initial equilibrium is MGDrivE absolute day 1, so absolute day 25
    // occurs on transition 24.
    defineConstant("RELEASE_TRANSITION", 24);
    defineConstant("RELEASE_COUNT", 10);
    defineConstant(
        "INITIAL_AQUATIC",
        asInteger(
            c(5000, 4867, 4737, 4611, 4488, 4368, 2108, 1017,
              491, 237, 114, 55, 54, 52, 51) * POP_SCALE
        )
    );

    if (CUBE == "mendelian3") {
        defineConstant("N_GENOTYPES", 3);
        defineConstant("N_LOCI", 1);
        defineConstant("N_ALLELES_0", 2);
        defineConstant("WILDTYPE_INDEX", 0);
        defineConstant("RELEASE_INDEX", 2);
    } else if (CUBE == "multiallele6") {
        defineConstant("N_GENOTYPES", 6);
        defineConstant("N_LOCI", 1);
        defineConstant("N_ALLELES_0", 3);
        defineConstant("WILDTYPE_INDEX", 0);
        defineConstant("RELEASE_INDEX", 4);
    } else if (CUBE == "twolocus9") {
        defineConstant("N_GENOTYPES", 9);
        defineConstant("N_LOCI", 2);
        defineConstant("N_ALLELES_0", 2);
        defineConstant("WILDTYPE_INDEX", 8);
        defineConstant("RELEASE_INDEX", 0);
    } else if (CUBE == "twolocus18") {
        defineConstant("N_GENOTYPES", 18);
        defineConstant("N_LOCI", 2);
        defineConstant("N_ALLELES_0", 3);
        defineConstant("WILDTYPE_INDEX", 0);
        defineConstant("RELEASE_INDEX", 11);
    } else {
        stop("unknown CUBE: " + CUBE);
    }
    // PAIR_BI indexes genotype states of a bi-allelic locus: 0=WW, 1=WA, 2=AA.
    // PAIR_TRI indexes a tri-allelic locus: 0=WW, 1=WA, 2=WB, 3=AA, 4=AB, 5=BB.
    defineConstant("PAIR_BI", c(0, 0, 0, 1, 1, 1));
    defineConstant("PAIR_TRI", c(0, 0, 0, 1, 0, 2, 1, 1, 1, 2, 2, 2));
    // cubeTwoLocusTA names the wildtype alleles a/b and orders the cube with
    // the homozygous-drive AABB genotype first, so its bi-allelic state order
    // is reversed relative to the SLiM mutation encoding.
    defineConstant("INVERT_BI", ifelse(CUBE == "twolocus9", T, F));

    initializeSLiMModelType("nonWF");
    // m1/m2 encode alleles 1/2 at locus 0; m3 encodes allele 1 at locus 1.
    initializeMutationType("m1", 0.5, "f", 0.0);
    initializeMutationType("m2", 0.5, "f", 0.0);
    initializeMutationType("m3", 0.5, "f", 0.0);
    m1.convertToSubstitution = F;
    m2.convertToSubstitution = F;
    m3.convertToSubstitution = F;
    initializeGenomicElementType(
        "g1",
        c(m1, m2, m3),
        c(1.0, 1.0, 1.0)
    );
    initializeGenomicElement(g1, 0, N_LOCI - 1);
    initializeMutationRate(0.0);
    initializeRecombinationRate(0.0);
    initializeSex("A");
}

function (integer$) alleleOfGenome(o<Haplosome>$ genome, integer$ locus) {
    if (locus == 0) {
        if (genome.countOfMutationsOfType(m1) > 0)
            return 1;
        if (genome.countOfMutationsOfType(m2) > 0)
            return 2;
        return 0;
    }
    if (genome.countOfMutationsOfType(m3) > 0)
        return 1;
    return 0;
}

function (integer$) sampleMaternalAllele(o<Individual>$ female, integer$ locus) {
    if (runif(1) < 0.5)
        return alleleOfGenome(female.haploidGenome1, locus);
    return alleleOfGenome(female.haploidGenome2, locus);
}

function (integer) allelesOfGenotype(integer$ genotype, integer$ locus) {
    if (locus == 0) {
        if (N_LOCI == 1) {
            state = genotype;
        } else {
            state = asInteger(genotype / 3);
        }
        if (N_ALLELES_0 == 3)
            return c(PAIR_TRI[state * 2], PAIR_TRI[state * 2 + 1]);
        if (INVERT_BI)
            state = 2 - state;
        return c(PAIR_BI[state * 2], PAIR_BI[state * 2 + 1]);
    }
    state = asInteger(genotype % 3);
    if (INVERT_BI)
        state = 2 - state;
    return c(PAIR_BI[state * 2], PAIR_BI[state * 2 + 1]);
}

function (integer$) paternalAllele(integer$ genotype, integer$ locus) {
    pair = allelesOfGenotype(genotype, locus);
    if (runif(1) < 0.5)
        return pair[0];
    return pair[1];
}

function (void) addAlleleToGenome(o<Haplosome>$ genome, integer$ locus, integer$ allele) {
    if (locus == 0) {
        if (allele == 1)
            genome.addNewDrawnMutation(m1, 0);
        else if (allele == 2)
            genome.addNewDrawnMutation(m2, 0);
    } else {
        if (allele == 1)
            genome.addNewDrawnMutation(m3, 1);
    }
}

function (void) makeReleaseGenotype(o<Individual>$ indiv) {
    indiv.haploidGenome1.removeMutations();
    indiv.haploidGenome2.removeMutations();
    for (locus in 0:(N_LOCI - 1)) {
        pair = allelesOfGenotype(RELEASE_INDEX, locus);
        addAlleleToGenome(indiv.haploidGenome1, locus, pair[0]);
        addAlleleToGenome(indiv.haploidGenome2, locus, pair[1]);
    }
}

function (integer$) locusState(o<Individual>$ indiv, integer$ locus) {
    first = alleleOfGenome(indiv.haploidGenome1, locus);
    second = alleleOfGenome(indiv.haploidGenome2, locus);
    if (locus == 0 & N_ALLELES_0 == 3) {
        low = min(c(first, second));
        high = max(c(first, second));
        return c(0, 3, 5)[low] + (high - low);
    }
    count = first + second;
    if (INVERT_BI)
        return 2 - count;
    return count;
}

function (integer$) genotypeIndex(o<Individual>$ indiv) {
    if (N_LOCI == 1)
        return locusState(indiv, 0);
    return locusState(indiv, 0) * 3 + locusState(indiv, 1);
}

function (integer) genotypeIndexes(o<Individual> individuals) {
    indexes = integer(size(individuals));
    for (i in seqLen(size(individuals)))
        indexes[i] = genotypeIndex(individuals[i]);
    return indexes;
}

function (integer) countsByGenotype(o<Individual> individuals) {
    counts = integer(N_GENOTYPES);
    if (size(individuals) == 0)
        return counts;
    indexes = genotypeIndexes(individuals);
    for (genotype in 0:(N_GENOTYPES - 1))
        counts[genotype] = sum(indexes == genotype);
    return counts;
}

1 first() {
    aquatic_total = sum(INITIAL_AQUATIC);
    // SLiM's sexRatio argument is the male fraction; MGDrivE uses 0.5.
    sim.addSubpop("p1", aquatic_total, 0.5);
    aquatic_individuals = sample(p1.individuals, aquatic_total);
    position = 0;
    for (stage in seqAlong(INITIAL_AQUATIC)) {
        count = INITIAL_AQUATIC[stage];
        aquatic_individuals[position:(position + count - 1)].tag = stage;
        position = position + count;
    }

    // Wildtype equilibrium adults are already mated to wildtype males.
    sim.addSubpop("p2", asInteger(250 * POP_SCALE), 0.0);
    p2.individuals.tag = 210 + WILDTYPE_INDEX;
    p1.takeMigrants(p2.individuals);
    sim.addSubpop("p3", asInteger(250 * POP_SCALE), 1.0);
    p3.individuals.tag = 100;
    p1.takeMigrants(p3.individuals);

    defineGlobal("BENCHMARK_START", clock());
}

2:100000 first() {
    focal = p1.individuals;
    focal.fitnessScaling = 1.0;

    // Existing adults survive before emergence, release, mating, and laying.
    adults = focal[
        focal.tag == 100 |
        (focal.tag >= 210 & focal.tag < 210 + N_GENOTYPES)
    ];
    if (size(adults) > 0) {
        adult_survives = runif(size(adults)) < ADULT_SURVIVAL;
        adults[!adult_survives].fitnessScaling = 0.0;
    }

    // Larval density is evaluated from the beginning-of-day population.
    larval_total = sum(focal.tag >= TIME_EGG &
                       focal.tag < (TIME_EGG + TIME_LARVA));
    density_survival = (
        ALPHA / (ALPHA + larval_total)
    )^(1.0 / TIME_LARVA);
    larval_survival = AQUATIC_SURVIVAL * density_survival;

    // Descending order prevents newly advanced individuals from being
    // processed twice during this daily transition.
    final_aquatic_stage = TIME_EGG + TIME_LARVA + TIME_PUPA - 1;
    for (stage in final_aquatic_stage:0) {
        cohort = focal[focal.tag == stage];
        if (size(cohort) == 0)
            next;
        survival = AQUATIC_SURVIVAL;
        if (stage >= TIME_EGG &
            stage < (TIME_EGG + TIME_LARVA))
            survival = larval_survival;
        stage_survives = runif(size(cohort)) < survival;
        cohort[!stage_survives].fitnessScaling = 0.0;
        survivors = cohort[stage_survives];

        if (stage < final_aquatic_stage) {
            survivors.tag = stage + 1;
        }
        else if (size(survivors) > 0) {
            // MGDrivE1 applies adult mortality once more upon emergence.
            emergence_survives =
                runif(size(survivors)) < ADULT_SURVIVAL;
            survivors[!emergence_survives].fitnessScaling = 0.0;
            emerged = survivors[emergence_survives];
            emerged[emerged.sex == "M"].tag = 100;
            emerged[emerged.sex == "F"].tag = 200;
        }
    }

    day = sim.cycle - 1;
    if (day == RELEASE_TRANSITION) {
        sim.addSubpop("p5", RELEASE_COUNT, 1.0);
        p5.individuals.tag = 100;
        for (indiv in p5.individuals)
            makeReleaseGenotype(indiv);
        p1.takeMigrants(p5.individuals);

        sim.addSubpop("p6", RELEASE_COUNT, 0.0);
        p6.individuals.tag = 200;
        for (indiv in p6.individuals)
            makeReleaseGenotype(indiv);
        p1.takeMigrants(p6.individuals);
    }

    // Store a mate genotype for every surviving unmated female.
    focal = p1.individuals;
    males = focal[focal.tag == 100 & focal.fitnessScaling > 0.0];
    unmated = focal[focal.tag == 200 & focal.fitnessScaling > 0.0];
    if (size(males) > 0) {
        for (female in unmated)
            female.tag = 210 + genotypeIndex(sample(males, 1));
    }
    else if (size(unmated) > 0) {
        // MGDrivE1 applies another adult survival draw while mating is blocked.
        blocked_survives = runif(size(unmated)) < ADULT_SURVIVAL;
        unmated[!blocked_survives].fitnessScaling = 0.0;
    }
}

2:100000 reproduction(p1, "F") {
    if (individual.tag < 210 |
        individual.tag >= 210 + N_GENOTYPES |
        individual.fitnessScaling == 0.0)
        return;
    mate_genotype = individual.tag - 210;
    offspring_count = rpois(1, BETA);
    for (offspring_index in seqLen(offspring_count)) {
        offspring = subpop.addRecombinant(
            individual.haploidGenome1,
            individual.haploidGenome2,
            NULL,
            individual.haploidGenome1,
            individual.haploidGenome2,
            NULL,
            parent1=individual,
            randomizeStrands=T
        );
        offspring.haploidGenome1.removeMutations();
        offspring.haploidGenome2.removeMutations();
        for (locus in 0:(N_LOCI - 1)) {
            maternal = sampleMaternalAllele(individual, locus);
            paternal = paternalAllele(mate_genotype, locus);
            addAlleleToGenome(offspring.haploidGenome1, locus, maternal);
            addAlleleToGenome(offspring.haploidGenome2, locus, paternal);
        }
        offspring.tag = 0;
        offspring.fitnessScaling = 1.0;
    }
}

1:100000 late() {
    day = sim.cycle - 1;
    if (TRACE) {
        trace_focal = p1.individuals;
        trace_males = trace_focal[trace_focal.tag == 100];
        trace_mated = trace_focal[
            trace_focal.tag >= 210 & trace_focal.tag < 210 + N_GENOTYPES
        ];
        trace_unmated = trace_focal[trace_focal.tag == 200];
        if (CUBE == "mendelian3") {
            trace_aa_adult = sum(
                trace_males.countOfMutationsOfType(m1) == 2
            ) + sum(
                trace_mated.countOfMutationsOfType(m1) == 2
            ) + sum(
                trace_unmated.countOfMutationsOfType(m1) == 2
            );
        } else {
            trace_aa_adult = -1;
        }
        trace_adult_total =
            size(trace_males) + size(trace_mated) + size(trace_unmated);
        catn(
            "TRACE:" +
            paste(c(day, trace_adult_total, trace_aa_adult), sep=",")
        );
    }
    if (day != N_DAYS)
        return;

    focal = p1.individuals;
    aquatic_total = sum(focal.tag < 100);
    unmated = focal[focal.tag == 200];
    males = focal[focal.tag == 100];
    mated = focal[
        focal.tag >= 210 & focal.tag < 210 + N_GENOTYPES
    ];
    male_counts = countsByGenotype(males);
    female_genotypes = genotypeIndexes(mated);
    female_counts = integer(N_GENOTYPES * N_GENOTYPES);
    for (female_genotype in 0:(N_GENOTYPES - 1)) {
        for (mate_genotype in 0:(N_GENOTYPES - 1)) {
            selected = mated[
                mated.tag == (210 + mate_genotype) &
                female_genotypes == female_genotype
            ];
            female_counts[female_genotype * N_GENOTYPES + mate_genotype] =
                size(selected);
        }
    }
    adult_total = size(males) + size(mated) + size(unmated);
    values = c(
        day,
        p1.individualCount,
        aquatic_total,
        size(unmated),
        adult_total,
        male_counts,
        female_counts
    );
    catn("OUT:" + paste(values, sep=","));
    catn("TIME:" + (clock() - BENCHMARK_START));
    sim.simulationFinished();
}
